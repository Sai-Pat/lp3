pragma solidity ^0.8.20;

// Student Data Management Smart Contract
contract StudentData {

    // Structure to store student information
    struct Student {
        uint rollNo;
        string name;
        uint age;
        string course;
    }

    // Array to store multiple students
    Student[] public students;

    // Add student details
    function addStudent(
        uint _rollNo,
        string memory _name,
        uint _age,
        string memory _course
    ) public {

        students.push(
            Student(_rollNo, _name, _age, _course)
        );
    }

    // Get student details using array index
    function getStudent(uint index)
        public
        view
        returns (
            uint,
            string memory,
            uint,
            string memory
        )
    {
        require(index < students.length, "Invalid index");

        Student memory s = students[index];

        return (
            s.rollNo,
            s.name,
            s.age,
            s.course
        );
    }

    // Get total number of students
    function getStudentCount() public view returns (uint) {
        return students.length;
    }

    // Fallback function
    fallback() external payable {
        // Executes when unknown function is called
    }

    // Receive function for direct Ether transfers
    receive() external payable {
        // Accepts Ether without calldata
    }
}
